# Copy these variable names into the private deployment .env file and fill in
# values from your hosting and Brevo account. Never put real values here.
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# Public origin of the deployed site, for example https://your-site.example
APP_URL=

# Existing Brevo SMTP configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
